#!/bin/bash

url="$1"

if [[ "$url" == file://* ]] && command -v emacsclient >/dev/null 2>&1; then
  file="${url#file://}"
  elisp="(progn
    (find-file \"${file//\"/\\\"}\")
    (select-frame-set-input-focus (selected-frame)))"

  emacsclient --no-wait --eval "$elisp"

  if command -v wmctrl >/dev/null 2>&1; then
    wmctrl -xa emacs
  elif [[ "$(uname -s)" == Darwin ]]; then
    osascript -e 'tell application "Emacs" to activate' 2>/dev/null
  fi
elif [[ "$(uname -s)" == Darwin ]]; then
  exec open "$url"
else
  exec xdg-open "$url"
fi
